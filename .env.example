# ==============================================================================
# DocuMind AI - Environment Configuration Template
# Copy this file to .env before starting the application:
#   PowerShell: Copy-Item .env.example .env
# ==============================================================================

# LLM Configuration (Groq Cloud API - Strictly Backend)
# Obtain your API key from: https://console.groq.com/keys
# Supported production models on Groq LPUs:
#   - llama-3.3-70b-versatile (Default flagship production model, 128k context)
#   - llama-3.1-8b-instant    (Ultra-fast lightweight model, 128k context)
# Security: Never expose this key in frontend code or commit to source control!
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile


# Embeddings & Vector Search Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_INDEX_DIR=data/indexes
UPLOAD_DIR=data/uploads
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# Server & Networking
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Environment (Vite exposes variables prefixed with VITE_)
# Note: Never put secret API keys in frontend variables!
VITE_API_BASE_URL=http://localhost:8000/api
